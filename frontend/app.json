{
  "expo": {
    "name": "Sharely",
    "slug": "sharely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sharely",
    "userInterfaceStyle": "automatic",
"newArchEnabled": true,
    "hermes": false,
    "ios": {
      "supportsTablet": true,
      "jsEngine": "jsc",
      "infoPlist": {
        "NSCameraUsageDescription": "Sharely needs camera access to take photos for stories and posts.",
        "NSPhotoLibraryUsageDescription": "Sharely needs photo library access to select images for posts and your profile.",
        "NSPhotoLibraryAddUsageDescription": "Sharely saves captured photos to your photo library.",
        "NSMicrophoneUsageDescription": "Sharely needs microphone access when recording video."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-camera",
      "expo-image-picker",
      "expo-media-library"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}